.venv/
.claude/
__pycache__/
*.pyc
results_*.json
.DS_Store

runner/node_modules/
runner/package-lock.json

# capture logs + scratch experiments (not part of the reproducible pipeline)
runner/*.log
runner/_*.mjs
runner/captest.js
runner/.eval-wip/

# Amazon Rufus session-state (regenerable via amazon-login.mjs)
runner/secrets/*-state.json

# transient per-conversation capture locks (O_EXCL cross-process locks, not data)
runner/results/*/conv/.locks/
