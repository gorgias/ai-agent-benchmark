{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/takeaways.html" }
  ],
  "redirects": [
    { "source": "/takeaways-v2", "destination": "/takeaways", "permanent": true },
    { "source": "/takeaways-v2.html", "destination": "/takeaways", "permanent": true },
    { "source": "/report-v2", "destination": "/report", "permanent": true },
    { "source": "/report-v2.html", "destination": "/report", "permanent": true },
    { "source": "/rubric.html", "destination": "/rubric", "permanent": true },
    { "source": "/results", "destination": "/", "permanent": true },
    { "source": "/results.html", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/login.html", "destination": "/", "permanent": true },
    { "source": "/vendor-changes", "destination": "/", "permanent": true },
    { "source": "/vendor-changes.html", "destination": "/", "permanent": true }
  ]
}
