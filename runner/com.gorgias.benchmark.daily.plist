<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily ~30-conversation benchmark run. Install:
       cp com.gorgias.benchmark.daily.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.gorgias.benchmark.daily.plist
     Unload: launchctl unload ~/Library/LaunchAgents/com.gorgias.benchmark.daily.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gorgias.benchmark.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/maxpruvost/ai-chat-latency-benchmark/runner/daily-run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/maxpruvost/ai-chat-latency-benchmark/runner/daily-run.log</string>
  <key>StandardErrorPath</key><string>/Users/maxpruvost/ai-chat-latency-benchmark/runner/daily-run.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
